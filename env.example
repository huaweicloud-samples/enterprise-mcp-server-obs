# Huawei Cloud Object Storage (OBS) configuration
OBS_REGION=cn-north-4

# Access credentials.
# NEVER commit real values. Inject these via environment variables or a
# secret manager. The values below are placeholders only.
HW_ACCESS_KEY=<your-access-key-id>
HW_SECRET_KEY=<your-secret-access-key>

# Maximum number of buckets to process
OBS_MAX_BUCKETS=5

# Specify buckets using either method:
# Method 1: Comma-separated list
OBS_BUCKETS=bucket1,bucket2,bucket3

# Method 2: Individual entries
# OBS_BUCKET_1=mybucket1
# OBS_BUCKET_2=mybucket2
# OBS_BUCKET_3=mybucket3
